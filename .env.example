# Copy this file to .env (for local `vercel dev`) or paste each value into
# Vercel → Project → Settings → Environment Variables. Never commit real secrets.

# --- Google Sheets (delegate database) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=apex-mun-sheets@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# --- Claude API (essay evaluator) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Resend (transactional email) ---
RESEND_API_KEY=re_...
FROM_EMAIL=registrations@apexmun.com
ADMIN_EMAIL=admin@apexmun.com

# --- Optional per-committee overrides (defaults shown) ---
UNSC_EMAIL=unsc@apexmun.com
UNHRC_EMAIL=unhrc@apexmun.com
DISEC_EMAIL=disec@apexmun.com

# --- Optional CORS lock-down (leave unset while testing) ---
ALLOWED_ORIGIN=https://apexmun.vercel.app
